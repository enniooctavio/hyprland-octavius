#!/usr/bin/env bash

# Notifica escaneamento
notify-send "Wi-Fi" "Buscando redes disponíveis..." -i network-wireless-symbolic

# Obtém redes disponíveis via nmcli
wifi_list=$(nmcli --fields "SECURITY,SSID,BARS" device wifi list | sed 1d | sed -E "s/^[[:space:]]+//" | sed -E "s/[[:space:]]+$//" | grep -v "^--" | awk -F'  +' '{print $2 " (" $1 ") [" $3 "]"}')

# Abre no Rofi
chosen_network=$(echo -e "󰤮  Desconectar\n󰖩  Ativar/Desativar Wi-Fi\n$wifi_list" | rofi -dmenu -i -p "  Redes Wi-Fi" -theme-str 'window {width: 400px;}')

# Trata a escolha
chosen_id=$(echo "$chosen_network" | awk '{print $1}')

if [ "$chosen_network" = "󰤮  Desconectar" ]; then
    nmcli device disconnect wlp0s20f3
elif [ "$chosen_network" = "󰖩  Ativar/Desativar Wi-Fi" ]; then
    nmcli radio wifi | grep -q "enabled" && nmcli radio wifi off || nmcli radio wifi on
elif [ -n "$chosen_network" ]; then
    # Verifica se a rede já é conhecida
    saved_connections=$(nmcli -g NAME connection)
    if echo "$saved_connections" | grep -qw "$chosen_id"; then
        nmcli connection up id "$chosen_id"
    else
        # Pede senha via rofi se for protegida
        if [[ "$chosen_network" =~ "WPA" ]] || [[ "$chosen_network" =~ "WEP" ]]; then
            wifi_password=$(rofi -dmenu -p "Senha para $chosen_id: " -password)
            nmcli device wifi connect "$chosen_id" password "$wifi_password"
        else
            nmcli device wifi connect "$chosen_id"
        fi
    fi
fi
