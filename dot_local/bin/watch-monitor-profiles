#!/usr/bin/env python3
"""Re-evaluate local monitor profiles after Hyprland output hotplug events."""

from __future__ import annotations

import os
import select
import socket
import subprocess
import time
from pathlib import Path


def main() -> None:
    runtime_dir = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    detector = Path.home() / ".local/bin/detect-workspaces.sh"
    if not signature:
        return

    socket_path = runtime_dir / "hypr" / signature / ".socket2.sock"
    for _ in range(45):
        if socket_path.exists():
            break
        time.sleep(1)
    else:
        return

    while socket_path.exists():
        client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            client.connect(str(socket_path))
        except OSError:
            client.close()
            time.sleep(1)
            continue

        pending_deadline = 0.0
        buffer = b""
        try:
            while True:
                timeout = None
                if pending_deadline:
                    timeout = max(0.0, pending_deadline - time.monotonic())
                readable, _, _ = select.select([client], [], [], timeout)
                if not readable:
                    subprocess.Popen(
                        [str(detector)],
                        stdin=subprocess.DEVNULL,
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        start_new_session=True,
                    )
                    pending_deadline = 0.0
                    continue

                chunk = client.recv(4096)
                if not chunk:
                    return
                buffer += chunk
                while b"\n" in buffer:
                    raw_line, buffer = buffer.split(b"\n", 1)
                    event = raw_line.decode("utf-8", errors="replace")
                    if event.startswith(("monitoradded>>", "monitorremoved>>")):
                        pending_deadline = time.monotonic() + 1.5
        except OSError:
            return
        finally:
            client.close()


if __name__ == "__main__":
    main()
