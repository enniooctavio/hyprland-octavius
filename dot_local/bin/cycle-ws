#!/usr/bin/env bash
set -euo pipefail

WS="$(hyprctl activeworkspace -j | jq -r '.id // empty')"
if [[ ! "$WS" =~ ^[0-9]+$ ]]; then
    echo "Could not determine the active numeric workspace" >&2
    exit 1
fi

case "$WS" in
    1|4|7) GROUP=(1 4 7) ;;
    2|5|8) GROUP=(2 5 8) ;;
    3|6|9|10) GROUP=(3 6 9 10) ;;
    *)
        echo "Workspace $WS is outside the configured monitor groups" >&2
        exit 1
        ;;
esac

NEXT="${GROUP[0]}"
for ((index = 0; index < ${#GROUP[@]}; index++)); do
    if [[ "${GROUP[index]}" == "$WS" ]]; then
        NEXT="${GROUP[$(((index + 1) % ${#GROUP[@]}))]}"
        break
    fi
done

if [[ "${1:-}" == "move" ]]; then
    hyprctl dispatch movetoworkspace "$NEXT"
else
    hyprctl dispatch workspace "$NEXT"
fi
