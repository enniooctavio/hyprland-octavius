{
    "layer": "top",
    "position": "top",
    "height": 24,
    "margin-top": 2,
    "margin-left": 5,
    "margin-right": 5,
    "modules-left": ["hyprland/workspaces", "custom/plus"],
    "modules-center": ["clock"],
    "modules-right": [
        "cpu",
        "memory",
        "hyprland/language",
        "pulseaudio#audio",
        "pulseaudio#mic",
        "backlight",
        "network",
        "battery",
        "custom/notification",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "all-outputs": false,
        "disable-scroll": true,
        "warp-on-scroll": false,
        "format": "{name}"
    },

    "custom/plus": {
        "format": "+",
        "tooltip": false,
        "on-click": "/home/ennio.octavio/.local/bin/cycle-ws"
    },

    "pulseaudio#audio": {
        "format": "{icon}  {volume}%",
        "format-muted": "󰝟  Mute",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 0,
        "on-click": "audio-menu output",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },

    "pulseaudio#mic": {
        "format": "{format_source}",
        "format-source": "🎤 {volume}%",
        "format-source-muted": "󰍭 Mute",
        "tooltip": false,
        "scroll-step": 0,
        "on-click": "audio-menu input",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-"
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip": false,
        "scroll-step": 5
    },

    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "󰈀 {ifname}",
        "format-disconnected": "⚠ Disconnected",
        "tooltip-format": "{ifname} via {gwaddr}"
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "US",
        "format-pt": "BR"
    },

    "clock": {
        "format": "{:%H:%M  %d/%m}",
        "format-alt": "{:%Y-%m-%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#ff2a85'><b>{}</b></span>",
                "days":       "<span color='#f8f8f2'><b>{}</b></span>",
                "weeks":      "<span color='#33ccff'><b>W{}</b></span>",
                "weekdays":   "<span color='#ffea00'><b>{}</b></span>",
                "today":      "<span color='#ff2a85'><b><u>{}</u></b></span>"
            }
        },
        "on-click": "kitty --class=cal-popup -e sh -c 'cal -y; echo Pressione Enter para fechar...; read'"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "󰘚 {used:0.1f}GB",
        "tooltip-format": "Usando: {used}GB / Total: {total}GB"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󱐋 {capacity}%",
        "format-plugged": " {capacity}%",
        "format-alt": "{icon} {time}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚<span foreground='#ff007c'><sup></sup></span>",
            "none": "󰂚",
            "dnd-notification": "󰂛<span foreground='#ff007c'><sup></sup></span>",
            "dnd-none": "󰂛",
            "inhibited-notification": "󰂚<span foreground='#ff007c'><sup></sup></span>",
            "inhibited-none": "󰂚",
            "dnd-inhibited-notification": "󰂛<span foreground='#ff007c'><sup></sup></span>",
            "dnd-inhibited-none": "󰂛"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "󰐥",
        "on-click": "/home/ennio.octavio/.local/bin/power-menu",
        "tooltip": false
    }
}
